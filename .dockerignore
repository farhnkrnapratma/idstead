# Dependencies (will be reinstalled inside the image)
node_modules

# Build outputs (produced inside the image)
.svelte-kit
dist
.output
build

# Cloudflare / Wrangler local state
.wrangler

# Version control
.git
.gitattributes

# OS artefacts
.DS_Store
Thumbs.db

# Editor configs
.vscode
.editorconfig

# Secrets — never bake into the image
.env
.env.*
!.env.example

# Agent / AI tooling (not needed at runtime)
.agents
.claude
.codex
.serena
graphify-out
skills-lock.json

# Nix
result
result-*
.direnv

# Caches
supabase/.temp
graphify-out/cache
