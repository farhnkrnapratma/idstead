{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-supabase-admin-in-svelte.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-sensitive-file-edits.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-deploy-config.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-bad-commit.sh",
            "if": "Bash(git commit:*)",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/hanz/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/hanz/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-write.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sync-claude-agents-md.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-before-stop.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/graphify-refresh.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {"typescript-lsp@claude-plugins-official": true}
}
