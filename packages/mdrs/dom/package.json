{
    "name": "@mdrs/dom",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "peerDependencies": {
        "@sveltejs/kit": "^3.1.1",
        "svelte": "^5.57.3"
    },
    "svelte": "./src/index.ts",
