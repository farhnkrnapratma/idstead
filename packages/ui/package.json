        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource/ia-writer-quattro": "^5.3.0",
        "@lucide/svelte": "^1.61.0",
        "bootstrap-icons": "^1.13.2"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^3.1.0",
        "svelte": "^5.57.2"
    }
