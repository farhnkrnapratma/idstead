or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:#lib[^'\"]*|@idstead/[^'\"]*|\$app/[^'\"]*|\$lib[^'\"]*|svelte|svelte/[^'\"]*)['\"]",
    not $source <: r"['\"](?:@idstead/domain|@idstead/domain/[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="@idstead/data is the server-only data layer: it may depend on @idstead/domain only.")
}
