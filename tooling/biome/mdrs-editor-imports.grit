or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:(?:[^'\"]*/)?server/[^'\"]*|#lib[^'\"]*|@idstead/lib|@idstead/lib/[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="@mdrs/editor takes data access through props: no lib or server imports.")
}
