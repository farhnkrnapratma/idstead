or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:(?:[^'\"]*/)?server/[^'\"]*|@idstead/data|@idstead/data/[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="Browser code must not import server-only modules.")
}
