or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:#lib[^'\"]*|@idstead/[^'\"]*|\$app/[^'\"]*|\$lib[^'\"]*|svelte|svelte/[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="@mdrs/core is a standalone engine: no app, lib, Svelte or data-access imports; inject resolvers instead.")
}
