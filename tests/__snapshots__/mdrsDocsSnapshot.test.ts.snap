exports[`MDRS docs examples render unchanged 001-markdown/007-footnotes.md #1 1`] = `
"<p>MDRS renders math on the server<sup><a id="mdrs-fn-ref-katex" href="#mdrs-fn-katex" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[1]</a></sup> and diagrams in the browser<sup><a id="mdrs-fn-ref-mermaid" href="#mdrs-fn-mermaid" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[2]</a></sup>.</p>
<section class="mdrs-footnotes" data-mdrs-footnotes="">
<h2 id="mdrs-fn-label" class="mdrs-sr-only">Footnotes</h2>
<ol>
<li id="mdrs-fn-katex">
<p><a href="#mdrs-fn-ref-katex" class="mdrs-footnote-backref" aria-label="Back to reference">^</a>With <a href="https://katex.org" class="mdrs-external-link" target="_blank" rel="noopener noreferrer">KaTeX<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mdrs-icon mdrs-icon-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></a>, so no client JavaScript is needed.</p>
</li>
<li id="mdrs-fn-mermaid">
<p><a href="#mdrs-fn-ref-mermaid" class="mdrs-footnote-backref" aria-label="Back to reference">^</a>Mermaid loads lazily when the diagram is rendered.</p>
</li>
</ol>
</section>
"
`;

exports[`MDRS docs examples render unchanged 001-markdown/007-footnotes.md #2 1`] = `
"<p>Cited once<sup><a id="mdrs-fn-ref-1" href="#mdrs-fn-1" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[1]</a></sup>, then twice<sup><a id="mdrs-fn-ref-2" href="#mdrs-fn-2" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[2]</a></sup> and again<sup><a id="mdrs-fn-ref-2-2" href="#mdrs-fn-2" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[2]</a></sup>.</p>
<section class="mdrs-footnotes" data-mdrs-footnotes="">
<h2 id="mdrs-fn-label" class="mdrs-sr-only">Footnotes</h2>
<ol>
<li id="mdrs-fn-1">
<p><a href="#mdrs-fn-ref-1" class="mdrs-footnote-backref" aria-label="Back to reference">^</a>Single back-link.</p>
</li>
<li id="mdrs-fn-2">
<p><span class="mdrs-footnote-backref-static" aria-hidden="true">^</span><span class="mdrs-footnote-backrefs"><a href="#mdrs-fn-ref-2" class="mdrs-footnote-backref mdrs-footnote-backref--sub" aria-label="Back to reference a">a</a><a href="#mdrs-fn-ref-2-2" class="mdrs-footnote-backref mdrs-footnote-backref--sub" aria-label="Back to reference b">b</a></span>Two back-links, a and b.</p>
</li>
</ol>
</section>
"
`;

exports[`MDRS docs examples render unchanged 001-markdown/007-footnotes.md #3 1`] = `
"<p>A long note<sup><a id="mdrs-fn-ref-long" href="#mdrs-fn-long" data-mdrs-fn-ref="" aria-describedby="mdrs-fn-label">[1]</a></sup>.</p>
<section class="mdrs-footnotes" data-mdrs-footnotes="">
