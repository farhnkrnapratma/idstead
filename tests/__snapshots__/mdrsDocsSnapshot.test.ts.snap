exports[`MDRS docs examples render unchanged 002-extensions/007-code-blocks.md #1 1`] = `
"<pre data-mdrs-highlight-lines="2,5,6,7" data-mdrs-filename="auth.svelte.ts"><code class="language-typescript">import { writable } from &#39;svelte/store&#39;;
import type { Session } from &#39;$lib/types&#39;;

export function createAuthStore(initial: Session | null) {
    let session = $state(initial);
    let isAuthenticated = $derived(session !== null);
    return { get session() { return session; }, get isAuthenticated() { return isAuthenticated; } };
}
</code></pre>
"
`;

