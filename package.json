{
    "name": "idstead",
    "version": "0.0.1",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*",
        "packages/mdrs/*"
    ],
    "scripts": {
        "lib-usage": "bun tooling/lib-usage.ts",
        "dev": "bun run --filter @idstead/web dev",
        "dev:admin": "bun run --filter @idstead/admin dev",
        "db:local": "cd apps/web && wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
        "build": "bun run --filter './apps/*' build",
        "configure": "bun tooling/configure.ts",
        "setup": "bun tooling/setup.ts",
        "check": "bun tooling/configure.ts --check && bun run --filter './apps/*' --filter './packages/*' --filter './packages/mdrs/*' check && tsc --noEmit -p tsconfig.json",
        "test": "bun test tests",
        "coverage": "bun tooling/coverage.ts",
        "prepare": "bun run --filter './apps/*' prepare; bash tooling/git-hooks/install.sh",
        "lint": "prettier --write . && eslint . && bun run lint:deprecated",
        "lint:deprecated": "eslint --config eslint.deprecated.config.ts apps/*/src packages/*/src packages/mdrs/*/src",
        "lint:fix": "eslint . --fix",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check ."
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@happy-dom/global-registrator": "^21.0.4",
        "@prettier/plugin-xml": "^3.4.2",
        "@types/bun": "1.4.4",
        "@types/node": "^26.6.6",
        "blobatar": "^2.7.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "fallow": "^3.42.0",
        "fflate": "^0.8.3",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "jose": "^6.2.17",
        "pdf-lib": "^1.17.1",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prettier-plugin-yaml": "^1.3.1",
        "rolldown": "^1.3.2",
        "svelte": "^5.57.3",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.2",
        "upng-js": "2.1.0",
        "uqr": "^0.1.3",
        "vite": "^8.3.8"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "esbuild",
        "sharp",
        "workerd"
    ],
    "overrides": {
        "katex": "^0.19.0",
        "undici": "7.30.1"
    }
}
