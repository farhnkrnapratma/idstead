{
    "name": "fkp",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter @fkp/web dev",
        "dev:production": "bun run --filter @fkp/web dev:production",
        "dev:admin": "bun run --filter @fkp/admin dev",
        "build": "bun run --filter './apps/*' build",
        "check": "bun run --filter './apps/*' --filter './packages/*' check",
        "test": "bun test tests",
        "prepare": "bun run --filter './apps/*' prepare; bash tooling/git-hooks/install.sh || echo ''",
        "lint": "prettier --write . && eslint .",
        "lint:fix": "eslint . --fix",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check ."
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1152.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@types/bun": "1.4.3",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prettier-plugin-yaml": "^1.3.1",
        "svelte": "^5.57.2",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.2"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "esbuild",
        "sharp",
        "workerd"
    ]
}
