    "@sentry/sveltekit": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "blobatar": "^2.7.0",
    "bootstrap-icons": "^1.13.2",
