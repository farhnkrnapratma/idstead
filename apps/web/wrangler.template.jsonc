{
    "name": "{{workers.web}}",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2025-06-28",
    "compatibility_flags": ["nodejs_compat"],
    "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
    "routes": "{{routes.web}}",
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
    },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "vars": { "SOURCE_URL": "{{source}}" },
    "d1_databases": "{{d1Databases}}",
    "ai": { "binding": "AI", "remote": true },
    "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "{{assetBucket}}", "remote": true }],
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "{{rateLimitNamespaces.web}}",
            "simple": { "limit": 60, "period": 60 }
        }
    ]
}
