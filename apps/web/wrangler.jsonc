{
    "name": "idstead-web",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2025-06-28",
    "compatibility_flags": ["nodejs_compat"],
    "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
    "routes": [
        { "pattern": "fkp.my.id", "custom_domain": true },
        { "pattern": "www.fkp.my.id", "custom_domain": true }
    ],
    "observability": { "enabled": true },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "idstead",
            "database_id": "01a9d5d0-7228-4791-ab9a-0813d73abbf3",
            "migrations_dir": "../../packages/data/d1/migrations"
        }
    ],
    "ai": { "binding": "AI", "remote": true },
    "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "static", "remote": true }],
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 60, "period": 60 }
        }
    ]
}
