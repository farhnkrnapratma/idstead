{
    "name": "@idstead/web",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "imports": {
        "#lib": "@idstead/lib",
        "#lib/*": "@idstead/lib/*",
        "#app/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "wrangler deploy",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources \"js,svelte\""
    },
    "dependencies": {
        "@idstead/data": "workspace:*",
        "@idstead/domain": "workspace:*",
        "@idstead/lib": "workspace:*",
        "@idstead/ui": "workspace:*",
        "@lucide/svelte": "^1.63.0",
        "@mdrs/core": "workspace:*",
        "@mdrs/dom": "workspace:*",
        "@sentry/sveltekit": "^11.9.0",
        "highlight.js": "^11.12.0",
        "katex": "^0.19.1",
        "uqr": "^0.1.3"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.1",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "wrangler": "^4.154.0"
    },
    "sideEffects": [
        "**/*.css"
    ]
}
