{
    "extends": "$app/tsconfig",
    "include": [
        "src",
        "test",
        "*",
        "../../packages/lib/src",
        "../../packages/mdrs/core/src",
        "../../packages/ui/src",
        "../../packages/domain/src",
        "../../packages/mdrs/dom/src",
        "../../packages/mdrs/editor/src"
    ],
    "exclude": ["src/service-worker"],
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": ["ESNext", "DOM"],
        "types": ["vite/client", "$app/types"],
        "allowArbitraryExtensions": true,
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    }
}
