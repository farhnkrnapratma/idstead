{
    "name": "@idstead/admin",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "imports": {
        "#lib": "@idstead/lib",
        "#lib/*": "@idstead/lib/*",
        "#app/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev --port 5174",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "wrangler deploy",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --diagnostic-sources \"js,svelte\""
    },
    "dependencies": {
        "@fontsource/ia-writer-quattro": "^5.3.0",
        "@idstead/data": "workspace:*",
        "@idstead/domain": "workspace:*",
        "@idstead/lib": "workspace:*",
        "@idstead/ui": "workspace:*",
        "@jsquash/avif": "^2.1.1",
        "@lucide/svelte": "^1.61.0",
        "@mdrs/core": "workspace:*",
        "@mdrs/dom": "workspace:*",
        "@mdrs/editor": "workspace:*",
        "@sentry/sveltekit": "^11.9.0",
        "@supabase/supabase-js": "^2.118.0",
        "blobatar": "^2.7.0",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "imagetracerjs": "1.2.6",
        "layerchart": "^2.9.1"
    },
    "devDependencies": {
        "@sveltejs/adapter-cloudflare": "^8.0.1",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "openpgp": "^6.3.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.5",
        "wrangler": "^4.152.0"
    },
    "sideEffects": [
        "**/*.css"
    ]
