{
    "name": "fkp-jobs",
    "main": "src/index.ts",
    "compatibility_date": "2025-06-28",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": { "enabled": true },
    "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "static", "remote": true }],
    "alias": { "$app/env/private": "./src/appEnv.ts", "$app/env/public": "./src/appEnv.ts" },
    "queues": {
        "consumers": [
            {
                "queue": "fkp-newsletter",
                "max_batch_size": 10,
                "max_retries": 5,
                "dead_letter_queue": "fkp-newsletter-dlq"
            },
            { "queue": "fkp-newsletter-dlq", "max_batch_size": 10, "max_retries": 0 }
        ]
    },
    "triggers": { "crons": ["17 3 * * *"] }
}
