{
    "name": "{{workers.jobs}}",
    "main": "src/index.ts",
    "compatibility_date": "2025-06-28",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": { "enabled": true },
    "d1_databases": "{{d1Databases}}",
    "secrets": {
        "required": [
            "PUBLIC_SUPABASE_URL",
            "PUBLIC_SUPABASE_PUBLISHABLE_KEY",
            "SUPABASE_SERVICE_ROLE_KEY",
            "PUBLIC_SITE_URL",
            "PUBLIC_CDN_BASE_URL",
            "PUBLIC_SENTRY_DSN",
            "PUBLIC_SENTRY_ENVIRONMENT",
            "RESEND_API_KEY",
            "SUBSCRIBER_FROM_EMAIL"
        ]
    },
    "r2_buckets": [{ "binding": "ASSET_BUCKET", "bucket_name": "{{assetBucket}}", "remote": true }],
    "alias": { "$app/env/private": "./src/appEnv.ts", "$app/env/public": "./src/appEnv.ts" },
    "queues": {
        "consumers": [
            {
                "queue": "{{newsletterQueue}}",
                "max_batch_size": 10,
                "max_retries": 5,
                "dead_letter_queue": "{{newsletterDeadLetterQueue}}"
            },
            { "queue": "{{newsletterDeadLetterQueue}}", "max_batch_size": 10, "max_retries": 0 }
        ]
    },
    "vars": { "HOURLY_CRON": "{{jobs.hourlyCron}}" },
    "triggers": { "crons": ["{{jobs.cron}}", "{{jobs.hourlyCron}}"] }
}
