{
    "name": "idstead-api",
    "main": "src/index.ts",
    "compatibility_date": "2025-06-28",
    "compatibility_flags": ["nodejs_compat"],
    "routes": [{ "pattern": "api.fkp.my.id", "custom_domain": true }],
    "observability": { "enabled": true },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "idstead",
            "database_id": "01a9d5d0-7228-4791-ab9a-0813d73abbf3",
            "migrations_dir": "../../packages/data/d1/migrations"
        }
    ],
    "alias": { "$app/env/private": "./src/appEnv.ts", "$app/env/public": "./src/appEnv.ts" },
    "secrets": {
        "required": [
            "PUBLIC_SUPABASE_URL",
            "PUBLIC_SUPABASE_PUBLISHABLE_KEY",
            "PUBLIC_SENTRY_DSN",
            "PUBLIC_SENTRY_ENVIRONMENT"
        ]
    },
    "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "1002",
            "simple": { "limit": 60, "period": 60 }
        }
    ]
}
