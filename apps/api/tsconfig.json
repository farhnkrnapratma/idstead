{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["@cloudflare/workers-types"],
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "erasableSyntaxOnly": true,
        "paths": { "$app/env/private": ["./src/appEnv.ts"], "$app/env/public": ["./src/appEnv.ts"] }
    },
    "include": ["src"]
}
